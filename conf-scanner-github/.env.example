# Relay — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Planning Center Online ─────────────────────────────────────────────────────
# Personal Access Token credentials from https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=your_pco_app_id
PCO_SECRET=your_pco_secret

# Planning Center form ID for this event (People → Forms → your form → URL)
PCO_FORM_ID=your_form_id

# Planning Center note category ID for milestone notes
# Find via: GET https://api.planningcenteronline.com/people/v2/note_categories
PCO_NOTE_CATEGORY_ID=your_note_category_id

# Optional: PCO custom field ID for storing badge IDs on person profiles
# PCO_BADGE_FIELD_ID=your_field_id

# ── Authentication ─────────────────────────────────────────────────────────────
# Shared password for staff login — change before each event
APP_PASSWORD=your_app_password

# Secret for signing session cookies — use a long random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret

# ── Azure Table Storage ────────────────────────────────────────────────────────
# Connection string from: Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string

# ── Server ────────────────────────────────────────────────────────────────────
# Port — Azure sets this automatically; leave as 3000 for local dev
PORT=3000
