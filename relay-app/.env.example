# Relay — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Planning Center Online ─────────────────────────────────────────────────────
# Personal Access Token from https://api.planningcenteronline.com/oauth/applications
# Create a new Personal Access Token for each event, rotate after the event ends
PCO_APP_ID=your_pco_app_id
PCO_SECRET=your_pco_secret

# The ID of the event registration form in PCO People → Forms
# Found in the URL when viewing the form: /people/forms/XXXXXXX
PCO_FORM_ID=your_form_id

# The ID of the note category for milestone notes
# Find via: GET https://api.planningcenteronline.com/people/v2/note_categories
# Notes will be written as: [VolunteerName] [MILESTONE:TYPE] PersonName — Label
PCO_NOTE_CATEGORY_ID=your_note_category_id

# Optional: PCO custom field ID for storing badge numbers on person profiles
# PCO_BADGE_FIELD_ID=your_field_id

# ── App Configuration ──────────────────────────────────────────────────────────
# Event name displayed in the app banner
# Example: Jesus is Lord Freedom Crusade
EVENT_NAME=Your Event Name

# Shared password for staff login — change before each event
# Tip: use something memorable but not your main org password
APP_PASSWORD=your_event_password

# Secret for signing session cookies — use a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_min_32_chars

# ── Azure Table Storage ────────────────────────────────────────────────────────
# Full connection string from: Azure Portal → Storage Account → Access keys
# Tables created automatically on first run:
#   badges, offline, followups, contactlog, auditlog, volunteers
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string

# ── Server ────────────────────────────────────────────────────────────────────
# Port — Azure/Railway set this automatically; leave as 3000 for local dev
PORT=3000
